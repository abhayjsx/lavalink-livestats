# Lavalink Live Stats Bot — Environment Variables

# ──────────────────────────────────────
# Discord Bot Configuration
# ──────────────────────────────────────
DISCORD_TOKEN=

# Channel ID where the live stats embed will be posted/updated
STATS_CHANNEL_ID=

# ──────────────────────────────────────
# Lavalink v4 Configuration
# ──────────────────────────────────────
LAVALINK_HOST=
LAVALINK_PORT=
LAVALINK_PASSWORD=

# Set to "true" if your Lavalink uses HTTPS/WSS (SSL)
LAVALINK_SECURE=

# ──────────────────────────────────────
# Optional Settings
# ──────────────────────────────────────
# How often to update the embed in milliseconds (default: 5000 = 5 seconds)
# Note: Discord rate-limits edits; below 5s is not recommended.
UPDATE_INTERVAL=5000

# A friendly name for your Lavalink node shown in the embed
NODE_NAME=K4rma's Lavalink
