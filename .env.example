# Lavalink Live Stats Bot — Environment Variables

# ──────────────────────────────────────
# Discord Bot Configuration
# ──────────────────────────────────────
DISCORD_TOKEN=

# Channel ID where the live stats embed will be posted/updated
STATS_CHANNEL_ID=

# ──────────────────────────────────────
# Lavalink Node 1 Configuration
# (Can also fallback to legacy LAVALINK_HOST, etc.)
# ──────────────────────────────────────
LAVALINK_1_HOST=
LAVALINK_1_PORT=
LAVALINK_1_PASSWORD=
LAVALINK_1_SECURE=false
NODE_1_NAME=Lavalink Node 1

# ──────────────────────────────────────
# Lavalink Node 2 Configuration
# ──────────────────────────────────────
LAVALINK_2_HOST=
LAVALINK_2_PORT=
LAVALINK_2_PASSWORD=
LAVALINK_2_SECURE=false
NODE_2_NAME=Lavalink Node 2

# ──────────────────────────────────────
# Optional Settings
# ──────────────────────────────────────
# How often to update the embed in milliseconds (default: 5000 = 5 seconds)
# Note: Discord rate-limits edits; below 5s is not recommended.
UPDATE_INTERVAL=5000
